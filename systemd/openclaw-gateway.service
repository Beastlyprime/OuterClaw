# /etc/systemd/system/openclaw-gateway.service
# SYSTEM-level service (root-managed). Agent cannot modify or stop this.
[Unit]
Description=OpenClaw Gateway (v2026.2.15)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ocagent
Group=ocagent
WorkingDirectory=/home/ocagent

# Validate data integrity before starting (prevents blind restart with corrupt data)
ExecStartPre=/var/lib/occlawshell/bin/pre-start-check.sh

# Wrapper script auto-generated by deploy.sh (detects Node/OpenClaw paths)
# Re-run deploy.sh after Node.js or OpenClaw updates to refresh paths
ExecStart=/var/lib/occlawshell/bin/start-gateway.sh

# ── Restart Policy ──
Restart=always
RestartSec=5

# ── Resource Containment ──
MemoryMax=8G
MemoryHigh=6G
CPUQuota=400%
TasksMax=512

# ── OOM Handling ──
OOMScoreAdjust=100
OOMPolicy=stop

# ── Post-crash forensics (runs as root: needs /proc access for full data collection) ──
ExecStopPost=+/var/lib/occlawshell/bin/postmortem-collect.sh openclaw-gateway

# ── Security Hardening ──
NoNewPrivileges=yes
PrivateTmp=yes

# ── Environment ──
Environment=HOME=/home/ocagent
# PATH is set by start-gateway.sh wrapper (auto-detected by deploy.sh)
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment=OPENCLAW_GATEWAY_PORT=18789
EnvironmentFile=-/home/ocagent/.openclaw/.env
Environment="OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.2.15

[Install]
WantedBy=multi-user.target
