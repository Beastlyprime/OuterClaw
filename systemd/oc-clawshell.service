# /etc/systemd/system/oc-clawshell.service
# ClawShell daemon — runs as occlawshell user
[Unit]
Description=ClawShell Sentry
After=openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=notify
User=occlawshell
Group=occlawshell
WorkingDirectory=/var/lib/occlawshell

ExecStart=/usr/bin/python3 /var/lib/occlawshell/bin/clawshell.py
Restart=always
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=10

# Watchdog: systemd kills ClawShell if it stops reporting within 120s
# ClawShell must call sd_notify("WATCHDOG=1") every <60s
WatchdogSec=120

# Self-protection: make ClawShell hard to OOM-kill
OOMScoreAdjust=-500
OOMPolicy=continue

# Lightweight — strict limits
MemoryMax=256M
MemoryHigh=192M
CPUQuota=10%
TasksMax=32

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/occlawshell
ReadOnlyPaths=/home/ocagent/.openclaw

# Config
EnvironmentFile=/var/lib/occlawshell/config/clawshell.env

[Install]
WantedBy=multi-user.target
