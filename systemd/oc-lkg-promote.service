# /etc/systemd/system/oc-lkg-promote.service
# OneShot: promote latest snapshot to LKG if gate checks pass
[Unit]
Description=OpenClaw LKG Promotion
After=oc-snapshot.service

[Service]
Type=oneshot
User=occlawshell
Group=occlawshell
ExecStart=/var/lib/occlawshell/bin/promote-lkg.sh
MemoryMax=256M
Nice=15
