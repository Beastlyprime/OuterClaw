# Ignore all by default
*

# ── Project files (whitelist) ──
!.gitignore
!README.md
!CLAUDE.md
!dev_plan.md
!deploy.sh
!install.sh
!clawshell.py
!test_clawshell.py

# Shell scripts
!scripts/
!scripts/*.sh

# systemd units
!systemd/
!systemd/*.service
!systemd/*.timer

# Logrotate
!logrotate/
!logrotate/occlawshell
